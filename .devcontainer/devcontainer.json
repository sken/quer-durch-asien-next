



{
	"name": "PNPM Dev Container",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"settings": {},
			"extensions": [
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"Prisma.prisma",
				"ms-azuretools.vscode-docker"
			]
		}
	},
	"postCreateCommand": "corepack enable && pnpm install",

	"forwardPorts": [3000],
	"portsAttributes": {
		"3000": {
			"label": "Web/Api",
			"onAutoForward": "notify"
		}
	},
  "remoteUser": "vscode"
}