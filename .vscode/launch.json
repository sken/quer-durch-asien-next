{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Next.js Web",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 9229,
      "console": "integratedTerminal"
    },
    {
      "name": "Launch API",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 9230,
      "console": "integratedTerminal"
    }
  ]
}
