DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Shared secret for write endpoints (POST/PUT/DELETE /colors), sent as `x-api-key`.
# Leave empty to disable write endpoints.
ADMIN_API_KEY=

# Comma-separated list of allowed browser origins. Defaults to localhost + quer-durch-asien.de domains.
CORS_ORIGINS=

# Set to "true" to publish new comments immediately; otherwise they wait for moderation.
COMMENTS_AUTO_APPROVE=false
