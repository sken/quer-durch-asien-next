# Apache config for the static site on All-Inkl (deployed from apps/web/out).
# HTTPS: enable Let's Encrypt and "SSL erzwingen" for the domain in KAS.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Pages and page data change with every deploy
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Build assets have content hashes in their names and never change
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
