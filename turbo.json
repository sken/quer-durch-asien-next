{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "CORS_ORIGINS",
        "ADMIN_API_KEY",
        "COMMENTS_AUTO_APPROVE",
        "PORT",
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "lint": {},
    "test": {
      "passThroughEnv": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "CORS_ORIGINS",
        "ADMIN_API_KEY",
        "COMMENTS_AUTO_APPROVE",
        "PORT",
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "test:e2e": {}
  }
}
